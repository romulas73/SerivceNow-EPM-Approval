    <script>
        window.ritmId = '${jvar_ritm_id}';
        
        // Set default values on page load
        window.onload = function() {
            document.getElementById('approved_type').value = 'Month';
            document.getElementById('approved_length').value = '12';
        };
        
        function updateApprovalLimits() {
            var typeSelect = document.getElementById('approved_type');
            var lengthInput = document.getElementById('approved_length');
            var selectedType = typeSelect.value;
            
            // Update max value and default based on type
            if (selectedType === 'Hour') {
                lengthInput.max = 24;
                lengthInput.value = 24;
            } else if (selectedType === 'Day') {
                lengthInput.max = 30;
                lengthInput.value = 30;
            } else if (selectedType === 'Month') {
                lengthInput.max = 12;
                lengthInput.value = 12;
            }
            
            lengthInput.min = 1;
        }
    </script>
