        <client_script><![CDATA[// Client Script Configuration:
// Name: RITM Approval Form Script
// UI Page: ritm_approval_form_page
// Table: (leave blank - UI Page script)
// Type: onLoad or onDemand
// Application: x_595889_cybr_epm

function approveRITM() {
    var ritmId = document.querySelector('[data-ritm-id]')?.getAttribute('data-ritm-id') || window.ritmId;
    var type = document.getElementById('approved_type').value;
    var length = document.getElementById('approved_length').value;
    
    // Debug logging
    console.log('Approval Type: ' + type);
    console.log('Approval Length: ' + length);
    
    if (!type) {
        alert('Please select an approval type (Hours, Days, or Months).');
        return;
    }
    
    if (!length || length < 1) {
        alert('Please enter a valid approval length.');
        return;
    }
    
    // Validate against max values
    if (type === 'hour' && length > 24) {
        alert('Hours cannot exceed 24.');
        return;
    }
    if (type === 'day' && length > 30) {
        alert('Days cannot exceed 30.');
        return;
    }
    if (type === 'month' && length > 12) {
        alert('Months cannot exceed 12.');
        return;
    }
    
    // Call the Script Include to process approval with scoped namespace
    var ga = new GlideAjax('x_595889_cybr_epm.RITMApprovalUtil');
    ga.addParam('sysparm_name', 'processApproval');
    ga.addParam('sysparm_ritm_id', ritmId);
    ga.addParam('sysparm_approved_type', type);
    ga.addParam('sysparm_approved_length', length);
    ga.addParam('sysparm_action', 'approve');
    
    console.log('Sending AJAX request with type: ' + type + ', length: ' + length);
    
    ga.getXML(function(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");
        console.log('Response from server: ' + answer);
        
        if (answer == 'success') {
            alert('RITM approved successfully for ' + length + ' ' + type + (length > 1 ? 's' : '') + '.');
            //window.parent.location.reload();
        } else {
            alert('Error processing approval: ' + answer);
        }
    });
}

function rejectRITM() {

    
    var ritmId = document.querySelector('[data-ritm-id]')?.getAttribute('data-ritm-id') || window.ritmId;
    
    // Call the Script Include to process rejection with scoped namespace
    var ga = new GlideAjax('x_595889_cybr_epm.RITMApprovalUtil');
    ga.addParam('sysparm_name', 'processApproval');
    ga.addParam('sysparm_ritm_id', ritmId);
    ga.addParam('sysparm_action', 'reject');
    ga.getXML(function(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");
        if (answer == 'success') {
            alert('RITM rejected successfully.');
            window.parent.location.reload();
        } else {
            alert('Error processing rejection: ' + answer);
        }
    });
}]]></client_script>
