        </div>

        <div class="section-header">Approval Decision</div>
        
        <div class="form-section">
            <div class="form-row">
                <div class="form-field">
                    <label>Approval Type: <span class="required">*</span></label>
                    <select id="approved_type" onchange="updateApprovalLimits()">
                        <option value="">-- Select Type --</option>
                        <option value="Hour">Hours</option>
                        <option value="Day">Days</option>
                        <option value="Month">Months</option>
                    </select>
                </div>
                
                <div class="form-field">
                    <label>Approval Length: <span class="required">*</span></label>
