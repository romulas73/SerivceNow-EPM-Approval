        <script><![CDATA[// UI Action Configuration:
// Name: Display Approval Form
// Table: sc_req_item
// Action name: display_approval_form
// Form button: true
// Client: true

function displayApprovalForm() {
    // Get the current RITM sys_id
    var ritmId = g_form.getUniqueValue();
    
    // Open the UI Page in a dialog
    var dialog = new GlideModal('cyberark_epm_approval_form_page', false, '800');
    dialog.setTitle('EPM Elevation Approval Form');
    dialog.setPreference('sysparm_ritm_id', ritmId);
    dialog.on('complete', function() {
        // Reload the form after approval/rejection
        g_form.reload();
    });
    dialog.render();
}

